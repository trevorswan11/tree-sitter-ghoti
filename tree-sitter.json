{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ghoti",
      "camelcase": "Ghoti",
      "scope": "source.ghoti",
      "file-types": ["gh"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^ghoti$"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Ghoti grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/trevorswan11/ghoti"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
